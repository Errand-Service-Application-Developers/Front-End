{
  "expo": {
    "name": "PintoShop",
    "slug": "PintoShop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./apps/assets/appicon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./apps/assets/splash-screen.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./apps/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./apps/assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
